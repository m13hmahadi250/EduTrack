# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://edutrackbd.vercel.app)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# In Vercel, you MUST manually set this in the Environment Variables dashboard.
APP_URL="https://edutrackbd.vercel.app"

# UploadThing Configuration
# Modern UploadThing (v7+) requires a unified UPLOADTHING_TOKEN.
# You can find this in your UploadThing project settings.
UPLOADTHING_TOKEN='eyJhcGlLZXkiOiJza19saXZlXzdlOTEwN2Y1ZGIxZmQ3MTEyYjkyYzcyYjI2NTYyZjA5YmY2N2U4NGFiNTVjZjM0ZjcxZGQ5ZmE2NTU4MDlkNWIiLCJhcHBJZCI6Ijc0bnR1eHA3amUiLCJyZWdpb25zIjpbInNlYTEiXX0='
