# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://edutrackbd.vercel.app)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# In Vercel, you MUST manually set this in the Environment Variables dashboard.
APP_URL="https://edutrackbd.vercel.app"

# Vercel Blob Configuration
# Get this from your Vercel project dashboard (Storage > Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_IY14KNd2re3cPbXz_XW6zNp7i1qN9unb3LNMvbXnC6sWsmm"
