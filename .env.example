# ============================================================================
# EDUTRACK BANGLADESH — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or configure in Vercel.
# NEVER commit real secrets, API keys, or private credentials to version control.
# ============================================================================

# --- 1. Transactional Email Service (Brevo / SMTP) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=edutrackbangladesh@gmail.com
BREVO_SENDER_NAME=EduTrack Bangladesh
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here

# --- 2. Cloudflare R2 Object Storage (Profile Photos, NID & Documents) ---
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=edutrack
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your_public_r2_domain.r2.dev

# --- 3. Secondary Audit Database (Optional MongoDB Mirror) ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/edutrack_bd

# --- 4. Firebase Admin / Server Verification (Optional) ---
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- 5. Map & Geolocation Services (Client-Safe Public Keys) ---
VITE_CARTO_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# --- 6. Optional AI Assistant Key (Server-Side Only) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- 7. Application Public URL ---
APP_URL=https://edutrackbd.vercel.app
