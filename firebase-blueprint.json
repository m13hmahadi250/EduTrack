{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a student, tutor, or admin in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "tutor", "admin"] },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "profileImage": { "type": "string" },
        "nidFrontImg": { "type": "string" },
        "nidBackImg": { "type": "string" },
        "documents": { "type": "array", "items": { "type": "string" } },
        "balance": { "type": "number" },
        "address": { "type": "string" },
        "group": { "type": "string" },
        "subject": { "type": "string" },
        "studentClass": { "type": "string" },
        "school": { "type": "string" },
        "semester": { "type": "string" },
        "year": { "type": "string" },
        "course": { "type": "string" },
        "university": { "type": "string" },
        "district": { "type": "string" },
        "area": { "type": "string" },
        "thana": { "type": "string" },
        "teachingAreas": { "type": "array", "items": { "type": "string" } },
        "nidNumber": { "type": "string" },
        "birthDate": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isTrackingOn": { "type": "boolean" },
        "hasDismissedProfileNotice": { "type": "boolean" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "rating": { "type": "number" },
        "totalRatings": { "type": "number" },
        "ratingSum": { "type": "number" },
        "availabilitySlots": { "type": "object" },
        "showTour": { "type": "boolean" },
        "whatsappNumber": { "type": "string" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "accountType": { "type": "string", "enum": ["student", "guardian"] },
        "guardianRelationship": { "type": "string" },
        "activeStudentProfileId": { "type": "string" },
        "studentName": { "type": "string" },
        "curriculum": { "type": "string" },
        "teachingMode": { "type": "string" },
        "profileCompletionPercentage": { "type": "number" },
        "hasProfilePhoto": { "type": "boolean" },
        "photoVersion": { "type": "number" },
        "privacySettings": { "type": "object" },
        "savedTuitions": { "type": "array", "items": { "type": "string" } },
        "notificationPreferences": {
          "type": "object",
          "properties": {
            "emailAlertsEnabled": { "type": "boolean" },
            "tuitionAlertFrequency": { "type": "string", "enum": ["instant", "daily_digest", "off"] },
            "inAppAlertsEnabled": { "type": "boolean" }
          }
        },
        "onboarding": { "type": "object" }
      },
      "required": ["id", "role", "name", "email"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "A child/student academic profile managed by a guardian account.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "guardianId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentClass": { "type": "string" },
        "school": { "type": "string" },
        "curriculum": { "type": "string" },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "gender": { "type": "string" },
        "district": { "type": "string" },
        "thana": { "type": "string" },
        "area": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "guardianId", "studentName", "studentClass", "school"]
    },
    "Payment": {
      "title": "Payment",
      "description": "A payment made via bKash.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "tutorId": { "type": "string" },
        "bKashNumber": { "type": "string" },
        "amount": { "type": "number" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "date": { "type": "string" }
      },
      "required": ["id", "studentId", "tutorId", "amount", "transactionId", "status", "date"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message between a user and tutor/student.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "isRead": { "type": "boolean" }
      },
      "required": ["id", "senderId", "receiverId", "participants", "content", "timestamp", "isRead"]
    },
    "Session": {
      "title": "Session",
      "description": "A tutoring session record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "tutorId": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "active", "completed", "cancelled", "proposed_by_tutor", "requested_by_student", "rejected"] },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "duration": { "type": "number" },
        "meetingLink": { "type": "string" },
        "rating": { "type": "number" },
        "feedback": { "type": "string" },
        "studentDisplayName": { "type": "string" },
        "isTrial": { "type": "boolean" },
        "trialStatus": { "type": "string", "enum": ["proposed_by_student", "rescheduled_by_tutor", "confirmed", "cancelled"] },
        "trialProposedBy": { "type": "string" },
        "tuitionId": { "type": "string" },
        "note": { "type": "string" },
        "rescheduleCount": { "type": "number" },
        "statusUpdatedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "tutorId", "subject", "status", "scheduledTime"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "A tutor withdrawal request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tutorId": { "type": "string" },
        "amount": { "type": "number" },
        "bKashNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "tutorId", "amount", "bKashNumber", "status", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A system or user notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type", "isRead", "timestamp"]
    },
    "ClassLog": {
      "title": "ClassLog",
      "description": "A record of a single class verified or log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "tutorId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "disputed"] },
        "subject": { "type": "string" },
        "notes": { "type": "string" },
        "loggedAt": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "tutorNotes": { "type": "string" }
      },
      "required": ["id", "studentId", "tutorId", "date", "status", "subject", "loggedAt"]
    },
    "HomeworkAssignment": {
      "title": "HomeworkAssignment",
      "description": "Represents a homework assignment created by a tutor for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tutorId": { "type": "string" },
        "studentId": { "type": "string" },
        "subject": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["assigned", "submitted", "completed", "revision"] },
        "createdAt": { "type": "string" },
        "submissionNotes": { "type": "string" },
        "submissionFileUrl": { "type": "string" },
        "submittedAt": { "type": "string" },
        "feedback": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["id", "tutorId", "studentId", "subject", "title", "text", "status", "createdAt"]
    },
    "ErrorLog": {
      "title": "ErrorLog",
      "description": "A secure record of runtime/global errors occurring on the client-side.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "message": { "type": "string" },
        "stack": { "type": "string" },
        "url": { "type": "string" },
        "timestamp": { "type": "string" },
        "userAgent": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "message", "stack", "url", "timestamp", "userAgent"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Records user referrals, referee profiles, and reward allocations.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referrerId": { "type": "string" },
        "referrerName": { "type": "string" },
        "referrerRole": { "type": "string", "enum": ["student", "tutor"] },
        "refereeId": { "type": "string" },
        "refereeName": { "type": "string" },
        "refereeEmail": { "type": "string" },
        "refereeRole": { "type": "string", "enum": ["student", "tutor"] },
        "status": { "type": "string", "enum": ["pending", "joined", "rewarded"] },
        "rewardType": { "type": "string", "enum": ["badge_points", "service_discount", "none"] },
        "rewardValue": { "type": "number" },
        "createdAt": { "type": "string" },
        "rewardedAt": { "type": "string" }
      },
      "required": ["id", "referrerId", "referrerName", "referrerRole", "refereeName", "refereeEmail", "status", "createdAt"]
    },
    "DownloadAttempt": {
      "title": "DownloadAttempt",
      "description": "A record of an Android app download attempt.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "timestamp": { "type": "string" },
        "platform": { "type": "string" },
        "source": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["id", "timestamp", "platform", "source"]
    },
    "TuitionPost": {
      "title": "TuitionPost",
      "description": "Public tuition circulars and student tutoring requirements.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "studentClass": { "type": "string" },
        "district": { "type": "string" },
        "area": { "type": "string" },
        "salary": { "type": "number" },
        "daysPerWeek": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "filled", "cancelled", "pending"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "subject", "district", "status"]
    },
    "PrivateMedia": {
      "title": "PrivateMedia",
      "description": "Owner-and-admin-only private media and verification documents (profile photo URL/key, NID images, academic documents).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "profileImage": { "type": "string" },
        "profilePhotoKey": { "type": "string" },
        "nidFrontImg": { "type": "string" },
        "nidBackImg": { "type": "string" },
        "documents": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      }
    },
    "NotificationEvent": {
      "title": "NotificationEvent",
      "description": "Server-tracked idempotency ledger for transactional workflow email notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventKey": { "type": "string" },
        "eventType": { "type": "string" },
        "actorId": { "type": "string" },
        "recipientId": { "type": "string" },
        "sessionId": { "type": "string" },
        "tuitionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "sent", "failed"] },
        "messageId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "eventKey", "eventType", "actorId", "recipientId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/tuitions/{tuitionId}": {
      "schema": "TuitionPost",
      "description": "Public tuition circulars"
    },
    "/tuition_posts/{postId}": {
      "schema": "TuitionPost",
      "description": "Public tuition posts"
    },
    "/download_attempts/{attemptId}": {
      "schema": "DownloadAttempt",
      "description": "Records of Android APK download attempts"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/private/{docId}": {
      "schema": "PrivateMedia",
      "description": "Owner and Admin only private photos and verification documents"
    },
    "/referrals/{referralId}": {
      "schema": "Referral",
      "description": "User referrals logs"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment records"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages"
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Tutoring sessions"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "Withdrawal requests"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/notification_events/{eventId}": {
      "schema": "NotificationEvent",
      "description": "Transactional email idempotency events"
    },
    "/class_logs/{classLogId}": {
      "schema": "ClassLog",
      "description": "Class date verification logs"
    },
    "/homework_assignments/{assignmentId}": {
      "schema": "HomeworkAssignment",
      "description": "Homework assignments and status tracking"
    },
    "/error_logs/{errorId}": {
      "schema": "ErrorLog",
      "description": "Secure client error logs"
    },
    "/student_profiles/{profileId}": {
      "schema": "StudentProfile",
      "description": "Child/student profiles managed by parent/guardian accounts"
    }
  }
}
