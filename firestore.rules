rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == 'edutrackbangladesh@gmail.com' ||
        request.auth.token.get('email', '') == 'm13hmahadi.personal@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == 'edutrackbangladesh@gmail.com' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == 'm13hmahadi.personal@gmail.com'))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.get('email', '') == 'admin@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function isVerifiedEmail() {
      return isSignedIn();
    }

    // --- Users Collection ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'role', 'name', 'email', 'balance', 'isVerified', 'isTrackingOn']) &&
               data.id == userId &&
               data.role in ['student', 'tutor', 'admin'] &&
               data.name is string && data.name.size() <= 128 &&
               data.email is string && data.email.size() <= 128 &&
               data.balance is number &&
               data.isVerified is bool &&
               data.isTrackingOn is bool &&
               (data.get('rating', null) == null || data.rating is number) &&
               (data.get('totalRatings', null) == null || data.totalRatings is number) &&
               (data.get('ratingSum', null) == null || data.ratingSum is number) &&
               (data.get('phone', null) == null || data.phone is string) &&
               (data.get('address', null) == null || data.address is string) &&
               (data.get('university', null) == null || data.university is string) &&
               (data.get('bio', null) == null || data.bio is string) &&
               (data.get('hourlyRate', null) == null || data.hourlyRate is number) &&
               (data.get('profileImage', null) == null || data.profileImage is string) &&
               (data.get('isBlocked', null) == null || data.isBlocked is bool) &&
               (data.get('showTour', null) == null || data.showTour is bool) &&
               (data.get('whatsappNumber', null) == null || data.whatsappNumber is string) &&
               (data.get('location', null) == null || (data.location is map && data.location.lat is number && data.location.lng is number));
      }

      allow read: if isSignedIn() || resource.data.role == 'tutor';

      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    (incoming().role != 'admin' || isSuperAdmin());

      allow update: if isAdmin() || (
                       (isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && 
                       (incoming().role == existing().role || isSuperAdmin()) && 
                       incoming().email == existing().email && 
                       (incoming().balance == existing().balance || (incoming().role == 'tutor' && incoming().balance < existing().balance) || isSuperAdmin()) && 
                       (incoming().isVerified == existing().isVerified || isSuperAdmin())
                    ) || (
                       isSignedIn() && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'ratingSum', 'totalRatings'])
                    ));

      allow delete: if isAdmin();
    }

    // --- Payments Collection ---
    match /payments/{paymentId} {
      function isValidPayment(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.studentId is string && data.studentId.size() <= 128 &&
               data.tutorId is string && data.tutorId.size() <= 128 &&
               data.amount is number && data.amount > 0 &&
               data.transactionId is string && data.transactionId.size() <= 128 &&
               data.status in ['pending', 'approved', 'rejected'] &&
               data.date is string && data.date.size() <= 128 &&
               data.bKashNumber is string && data.bKashNumber.size() <= 128;
      }

      allow list: if isAdmin();
      allow list: if isSignedIn() && resource.data.tutorId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow get: if isAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.tutorId == request.auth.uid));
      
      allow create: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming()) && 
                    ((incoming().studentId == request.auth.uid && incoming().status == 'pending') ||
                     (incoming().tutorId == request.auth.uid && incoming().studentId == 'admin' && incoming().status == 'pending'));

      allow update: if (isAdmin() && isValidPayment(incoming())) || (
        isSignedIn() && resource.data.studentId == request.auth.uid && 
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status == 'cancelled'
      );
      
      allow delete: if isAdmin();
    }

    // --- Messages Collection ---
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['id', 'senderId', 'receiverId', 'participants', 'content', 'timestamp', 'isRead']) &&
               data.content is string && data.content.size() <= 5000 &&
               data.senderId == (request.method == 'create' ? request.auth.uid : existing().senderId) &&
               data.participants.size() == 2 &&
               (request.auth.uid in data.participants);
      }

      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      
      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
      
      allow update: if isSignedIn() && (
        (request.auth.uid == existing().receiverId && 
         incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) &&
         incoming().isRead == true)
      );

      allow delete: if isAdmin();
    }

    // --- Sessions Collection ---
    match /sessions/{sessionId} {
      function isValidSession(data) {
        return data.keys().hasAll(['id', 'studentId', 'tutorId', 'subject', 'status', 'scheduledTime']) &&
               isValidId(data.studentId) && isValidId(data.tutorId) &&
               data.subject is string && data.subject.size() <= 200 &&
               data.status in ['scheduled', 'active', 'completed', 'cancelled', 'proposed_by_tutor', 'requested_by_student', 'rejected'] &&
               data.scheduledTime is string;
      }

      allow list: if isAdmin() || (isSignedIn() && resource.data.tutorId == request.auth.uid) || (isSignedIn() && resource.data.studentId == request.auth.uid) || (resource.data.get('rating', 0) > 0);
      allow get: if isAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.tutorId == request.auth.uid)) || (resource.data.get('rating', 0) > 0);

      allow create: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming()) && 
                    (incoming().studentId == request.auth.uid || incoming().tutorId == request.auth.uid) &&
                    incoming().status in ['scheduled', 'proposed_by_tutor', 'requested_by_student'];

      allow update: if isAdmin() || (
        isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.tutorId == request.auth.uid) && isValidSession(incoming())
      );

      allow delete: if isAdmin();
    }

    // --- Withdrawals Collection ---
    match /withdrawals/{withdrawalId} {
      function isValidWithdrawal(data) {
        return data.keys().hasAll(['id', 'tutorId', 'amount', 'bKashNumber', 'status', 'timestamp', 'paymentMethod']) &&
               isValidId(data.tutorId) &&
               data.amount is number && data.amount > 0 &&
               data.bKashNumber is string && data.bKashNumber.size() <= 64 &&
               data.status in ['pending', 'approved', 'rejected'] &&
               data.timestamp is string &&
               data.paymentMethod in ['bkash', 'nagad', 'bank'] &&
               (data.get('adminNote', null) == null || data.adminNote is string);
      }

      allow list: if isAdmin() || (isSignedIn() && resource.data.tutorId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.tutorId == request.auth.uid);

      allow create: if isSignedIn() && isValidId(withdrawalId) && isValidWithdrawal(incoming()) && 
                    incoming().tutorId == request.auth.uid &&
                    incoming().status == 'pending';

      allow update: if isAdmin() && isValidWithdrawal(incoming());

      allow delete: if isAdmin();
    }
    
    // Ledger for financial auditing
    match /ledger/{ledgerId} {
      allow read, write: if isAdmin();
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      function isValidNotification(data) {
        return data.keys().hasAll(['id', 'userId', 'title', 'message', 'type', 'isRead', 'timestamp']) &&
               isValidId(data.id) &&
               isValidId(data.userId) &&
               data.title is string && data.title.size() <= 200 &&
               data.message is string && data.message.size() <= 2000 &&
               data.type in ['info', 'success', 'warning', 'error'] &&
               data.isRead is bool &&
               data.timestamp is string;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming());
      
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        (isValidNotification(incoming()) && incoming().userId == existing().userId)
      );
      
      allow delete: if isAdmin();
    }

    // --- Class Logs Collection ---
    match /class_logs/{classLogId} {
      function isValidClassLog(data) {
        return data.keys().hasAll(['id', 'studentId', 'tutorId', 'date', 'status', 'subject', 'loggedAt']) &&
               isValidId(data.id) &&
               isValidId(data.studentId) &&
               isValidId(data.tutorId) &&
               data.date is string && data.date.size() <= 32 &&
               data.status in ['pending', 'verified', 'disputed'] &&
               data.subject is string && data.subject.size() <= 200 &&
               data.loggedAt is string &&
               (data.get('notes', null) == null || data.notes is string) &&
               (data.get('reviewedAt', null) == null || data.reviewedAt is string) &&
               (data.get('tutorNotes', null) == null || data.tutorNotes is string);
      }

      allow list: if isAdmin();
      allow list: if isSignedIn() && resource.data.tutorId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow get: if isAdmin() || (isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.tutorId == request.auth.uid));

      allow create: if isSignedIn() && isValidId(classLogId) && isValidClassLog(incoming()) &&
                    incoming().studentId == request.auth.uid &&
                    incoming().status == 'pending';

      allow update: if isAdmin() || (
        isSignedIn() && isValidClassLog(incoming()) && (
          (resource.data.tutorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasAny(['status', 'reviewedAt', 'tutorNotes'])) ||
          (resource.data.studentId == request.auth.uid && incoming().studentId == request.auth.uid)
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }

    // --- Typing Indicators ---
    match /typing/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && 
                   (incoming().get('typingTo', null) == null || isValidId(incoming().typingTo));
    }

    // --- System Config ---
    match /system/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Error Logs Collection ---
    match /error_logs/{errorId} {
      function isValidErrorLog(data) {
        return data.keys().hasAll(['id', 'message', 'stack', 'url', 'timestamp', 'userAgent']) &&
               data.id == errorId &&
               data.message is string && data.message.size() <= 4096 &&
               data.stack is string && data.stack.size() <= 12288 &&
               data.url is string && data.url.size() <= 2048 &&
               data.timestamp is string &&
               data.userAgent is string && data.userAgent.size() <= 1024 &&
               (data.get('userId', null) == null || data.userId is string);
      }

      allow list, get: if isAdmin();
      allow create: if isValidId(errorId) && isValidErrorLog(incoming());
      allow update, delete: if false;
    }

    // --- Referrals Collection ---
    match /referrals/{referralId} {
      function isValidReferral(data) {
        return data.keys().hasAll(['id', 'referrerId', 'referrerName', 'referrerRole', 'refereeName', 'refereeEmail', 'status', 'createdAt']) &&
               data.id == referralId &&
               data.referrerId is string && data.referrerId.size() <= 128 &&
               data.referrerName is string && data.referrerName.size() <= 128 &&
               data.referrerRole in ['student', 'tutor', 'admin'] &&
               data.refereeName is string && data.refereeName.size() <= 128 &&
               data.refereeEmail is string && data.refereeEmail.size() <= 128 &&
               data.status in ['pending', 'joined', 'rewarded'] &&
               data.createdAt is string &&
               (data.get('refereeId', null) == null || (data.refereeId is string && data.refereeId.size() <= 128)) &&
               (data.get('rewardType', null) == null || data.rewardType in ['badge_points', 'service_discount', 'none']) &&
               (data.get('rewardValue', null) == null || data.rewardValue is number) &&
               (data.get('rewardedAt', null) == null || data.rewardedAt is string);
      }

      allow list: if isAdmin() || (isSignedIn() && resource.data.referrerId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.referrerId == request.auth.uid);
      
      allow create: if isSignedIn() && isValidId(referralId) && isValidReferral(incoming()) && 
                    (incoming().referrerId == request.auth.uid);
                    
      allow update: if isAdmin() || (
        isSignedIn() && isValidReferral(incoming()) && 
        incoming().referrerId == request.auth.uid && 
        incoming().referrerId == existing().referrerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['refereeId', 'status', 'rewardType', 'rewardValue', 'rewardedAt'])
      );
      
      allow delete: if isAdmin();
    }

    // --- Download Attempts Collection ---
    match /download_attempts/{attemptId} {
      function isValidDownloadAttempt(data) {
        return data.keys().hasAll(['id', 'timestamp', 'platform', 'source']) &&
               data.id == attemptId &&
               data.timestamp is string && data.timestamp.size() <= 128 &&
               data.platform is string && data.platform.size() <= 128 &&
               data.source is string && data.source.size() <= 128 &&
               (data.get('userId', null) == null || (data.userId is string && data.userId.size() <= 128)) &&
               (data.get('userEmail', null) == null || (data.userEmail is string && data.userEmail.size() <= 128)) &&
               (data.get('userAgent', null) == null || (data.userAgent is string && data.userAgent.size() <= 2048));
      }

      allow list, get: if isAdmin();
      allow create: if isValidId(attemptId) && isValidDownloadAttempt(incoming());
      allow update, delete: if false;
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
